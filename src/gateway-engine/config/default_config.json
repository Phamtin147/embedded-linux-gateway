{
  "gateway_id": "gw-arm-001",
  "polling_interval_ms": 1000,
  "modbus": {
    "enabled": true,
    "port": "/dev/ttyUSB0",
    "baudrate": 9600,
    "parity": "N",
    "data_bits": 8,
    "stop_bits": 1,
    "slave_id": 1,
    "registers": [
      {"name": "temperature", "address": 0, "type": "int16", "scale": 0.1},
      {"name": "humidity", "address": 1, "type": "int16", "scale": 0.1},
      {"name": "pressure", "address": 2, "type": "uint16", "scale": 1.0}
    ]
  },
  "can": {
    "enabled": true,
    "interface": "vcan0",
    "filters": [
      {"can_id": 256, "mask": 2047}
    ]
  },
  "mqtt": {
    "broker_host": "127.0.0.1",
    "broker_port": 1883,
    "client_id": "iiot-gateway-001",
    "telemetry_topic": "gateway/gw-arm-001/telemetry",
    "command_topic": "gateway/gw-arm-001/command",
    "use_tls": false
  },
  "storage": {
    "db_path": "/data/gateway.db",
    "max_buffer_size_mb": 100
  },
  "watchdog": {
    "enabled": true,
    "interval_sec": 10
  }
}
